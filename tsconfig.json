{
  // Type checking only (npm run typecheck): tsx runs the code without checking types.
  // The tests are left out: their mocks are partial objects on purpose
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["server.ts", "mcp-core.d.ts", "routes", "services"]
}
